# Release profile inputs. Leave blank in Git; the app owner supplies values.
# APP_VARIANT: development (default, Expo Go) | preview | production
APP_VARIANT=
# Required only when APP_VARIANT=production:
ALREADYUP_APP_NAME=
ALREADYUP_IOS_BUNDLE_ID=
ALREADYUP_ANDROID_PACKAGE=
ALREADYUP_PRIVACY_URL=
ALREADYUP_SUPPORT_URL=
# Set to true only after the owner approves the icon/adaptive icon/splash assets.
ALREADYUP_ASSETS_APPROVED=
# Optional (EAS is not needed for a local production build):
ALREADYUP_EAS_OWNER=
